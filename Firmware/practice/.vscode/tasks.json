{
    "version": "2.0.0",

    "tasks": [

        {
            "type": "shell",
            "label": "C: 编译当前文件夹所有C文件",

            "command": "powershell.exe",

            "args": [
                "-NoProfile",
                "-Command",

                "$src = Get-ChildItem -LiteralPath '${fileDirname}' -Filter '*.c' -File | ForEach-Object { $_.FullName }; $outDir = Join-Path '${fileDirname}' 'output'; New-Item -ItemType Directory -Force -Path $outDir | Out-Null; & 'C:\\msys64\\ucrt64\\bin\\gcc.exe' -fdiagnostics-color=always -Wall -Wextra -g3 $src -o (Join-Path $outDir 'main.exe'); exit $LASTEXITCODE"
            ],

            "options": {
                "cwd": "${fileDirname}"
            },

            "problemMatcher": [
                "$gcc"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },


        {
            "type": "shell",
            "label": "C: 编译并运行当前工程",

            "command": "powershell.exe",

            "args": [
                "-NoProfile",
                "-Command",
                "& '${fileDirname}\\output\\main.exe'"
            ],

            "options": {
                "cwd": "${fileDirname}"
            },

            "dependsOn": [
                "C: 编译当前文件夹所有C文件"
            ],

            "dependsOrder": "sequence",

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },


        {
            "type": "shell",
            "label": "C: 编译运行并保存日志",

            "command": "powershell.exe",

            "args": [
                "-NoProfile",
                "-Command",
                "& '${fileDirname}\\output\\main.exe' | Tee-Object -FilePath '${fileDirname}\\output\\main.log'"
            ],

            "options": {
                "cwd": "${fileDirname}"
            },

            "dependsOn": [
                "C: 编译当前文件夹所有C文件"
            ],

            "dependsOrder": "sequence",

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }

    ]
}