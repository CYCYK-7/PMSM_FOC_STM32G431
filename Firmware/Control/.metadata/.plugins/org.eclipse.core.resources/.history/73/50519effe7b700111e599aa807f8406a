static void Hall_UpdateState(void)
{
    hall_a =
        (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_6) == GPIO_PIN_SET);

    hall_b =
        (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_7) == GPIO_PIN_SET);

    hall_c =
        (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_8) == GPIO_PIN_SET);


    hall_state =
        (hall_a << 2) |
        (hall_b << 1) |
         hall_c;
}

static int8_t Hall_StateToSector(uint8_t state)
{
    switch (state)
    {
        case 1:  return 0;   // 001
        case 3:  return 1;   // 011
        case 2:  return 2;   // 010
        case 6:  return 3;   // 110
        case 4:  return 4;   // 100
        case 5:  return 5;   // 101

        default:
        	return -1;  // 000 / 111 invalid
    }
}

static void Hall_UpdateDirection(int8_t new_sector)
{
    /* Invalid Hall state */
    if (new_sector < 0)    //后面引用是里面放的是hall_sector，这个�?�初始定义为-1，这说明当没转的时�?�还不知道方�?
    	                   // 但是在中断中hall_sector = Hall_StateToSector(hall_state);
    {
        hall_direction = HALL_DIR_UNKNOWN;
        return;
    }


    /* First valid Hall state */
    if (hall_prev_sector < 0)  // 当刚�?机没转时候，程序等于没存前一次的sector的�?�，�?以到定义，为�?么定义为-1呢，
    	                       // 这是因为，为了方便将第一次采集到的�?�幅值给hall_prev_sector
    {
        hall_prev_sector = new_sector;
        return;
    }


    /* Clockwise */
    if (new_sector ==
        ((hall_prev_sector + 1) % 6))
    {
        hall_direction = HALL_DIR_CW;
    }

    /* Counter-clockwise */
    else if (new_sector ==
             ((hall_prev_sector + 5) % 6))
    {
        hall_direction = HALL_DIR_CCW;
    }

    /* Illegal jump */
    else if (new_sector != hall_prev_sector)  //use record illegal jump
    {
        hall_direction = HALL_DIR_UNKNOWN;
    }


    hall_prev_sector = new_sector;
}

static void Hall_UpdateSpeed(uint32_t capture)
{
    float delta_t;
    float direction_sign;


    /* Invalid capture */
    if (capture == 0U)
    {
        hall_speed_valid = 0;
        return;
    }


    /* Direction cannot be determined yet */
    if (hall_direction == HALL_DIR_UNKNOWN)
    {
        hall_speed_valid = 0;
        return;
    }


    /* Capture count -> seconds */
    delta_t =
        (float)capture
        * HALL_TIMER_TICK_S;


    /* CW positive, CCW negative */
    direction_sign =
        (hall_direction == HALL_DIR_CW)
        ? 1.0f
        : -1.0f;


    /* Electrical angular velocity */
    hall_omega_e =
        direction_sign
        * (PI_F / 3.0f)
        / delta_t;


    /* Mechanical angular velocity */
    hall_omega_m =
        hall_omega_e
        / MOTOR_POLE_PAIRS;


    /* Mechanical speed */
    hall_speed_rpm =
        hall_omega_m
        * 60.0f
        / (2.0f * PI_F);


    /* Speed is now valid */
    hall_speed_valid = 1;
}

static void Hall_CheckTimeout(void)
{
    uint32_t now;


    /*
     * No valid speed has been obtained yet.
     */
    if (hall_speed_valid == 0)
    {
        return;
    }


    now = HAL_GetTick();


    /*
     * No Hall edge for too long.
     */
    if ((uint32_t)(now - hall_last_edge_ms)
        > HALL_STOP_TIMEOUT_MS)
    {
        hall_speed_rpm = 0.0f;

        hall_omega_m = 0.0f;

        hall_omega_e = 0.0f;


        hall_speed_valid = 0;


        /*
         * Once stopped, old direction
         * should no longer be trusted.
         */
        hall_direction =
            HALL_DIR_UNKNOWN;


        /*
         * Restart direction detection
         * from next Hall transition.
         */
        hall_prev_sector = -1;
    }
}

