static uint32_t DutyToCCR(float duty)
{
    uint32_t arr;
    uint32_t period;
    uint32_t ccr;

    arr =
        __HAL_TIM_GET_AUTORELOAD(&htim1);

    period =
        arr + 1U;


    if (duty < 0.0f)
    {
        duty = 0.0f;
    }

    if (duty > 1.0f)
    {
        duty = 1.0f;
    }


    ccr =
        (uint32_t)(duty * (float)period);


    if (ccr > arr)
    {
        ccr = arr;
    }


    return ccr;
}

