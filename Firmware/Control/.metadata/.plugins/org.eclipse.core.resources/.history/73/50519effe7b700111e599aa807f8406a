void HAL_ADCEx_InjectedConvCpltCallback(ADC_HandleTypeDef *hadc)
{
    if (hadc->Instance == ADC1)
    {
        iu_raw_sync =
            HAL_ADCEx_InjectedGetValue(&hadc1,
                                       ADC_INJECTED_RANK_1);

        current_sample_ready |= 0x01; //01
    }

    if (hadc->Instance == ADC2)
    {
        iv_raw_sync =
            HAL_ADCEx_InjectedGetValue(&hadc2,
                                       ADC_INJECTED_RANK_1);

        current_sample_ready |= 0x02; //10
    }

    /* U、V两相本周期数据都已经到齐 */
    if (current_sample_ready == 0x03) // 11
    {
        current_sample_ready = 0;

		vdc_bus =(float) vdc_adc_raw * VDC_VOLTS_PER_COUNT;  //后面 READY �?? FAULT 状�?�需要知�?? Vdc

        adc_injected_count++;

        /* DC bus protection */
        FOC_CheckVdcProtection();

        if (foc_fault_request) // 不加这个的话，真正foc_state = FOC_STATE_FAULT;要等while�??1）中的FOC_StateManager();执行之后
        {
            return;
        }

        /* ---------- Offset calibration ---------- */
        if (foc_state == FOC_STATE_CALIBRATION)
        {
            iu_offset_sum += iu_raw_sync;
            iv_offset_sum += iv_raw_sync;

            current_offset_count++;

            if (current_offset_count >= CURRENT_OFFSET_SAMPLES)
            {
                iu_offset_adc =
                    (uint16_t)(iu_offset_sum / CURRENT_OFFSET_SAMPLES);

                iv_offset_adc =
                    (uint16_t)(iv_offset_sum / CURRENT_OFFSET_SAMPLES);

                current_offset_done = 1;

                FOC_ResetControl();
                FOC_SetNeutralPWM();

                FOC_PWM_Disable();

                foc_state = FOC_STATE_READY;//after calibration state manager into ready
            }
            /*
             * 很重要：
             * CALIBRATION 状�?�做到这里就结束本次ADC回调�??
             * 不继续算电流、Park、PI�??
             */
            return;
        }

        /* ==================================================
         * 2. INIT / FAULT 状�?�直接�??�??
         * ================================================== */
        if ((foc_state == FOC_STATE_INIT) ||
            (foc_state == FOC_STATE_FAULT))
        {
            return;
        }

        /* ---------- Current calculation ---------- */
        /* ==================================================
         * 3. READY �?? RUN 都允许走到这�??
         *    �??以继续计算实际电�??
         * ================================================== */

		iu_adc_delta =
			(int32_t)iu_raw_sync - (int32_t)iu_offset_adc;

		iv_adc_delta =
			(int32_t)iv_raw_sync - (int32_t)iv_offset_adc;

		/*
		 * Current Board�??
		 * Rsense = 5mΩ
		 * OPAMP Gain �?? 7.33
		 *
		 * �?? 21.98 mA / ADC count
		 */
		iu_ma = iu_adc_delta * 2198L / 100L;
		iv_ma = iv_adc_delta * 2198L / 100L;

		/* mA -> A */
		iu_a = (float)iu_ma * 0.001f;
		iv_a = (float)iv_ma * 0.001f;

		/* Clarke Transform */
		Clarke_Run(iu_a,
				   iv_a,
				   &i_ab);

		/* Test electrical angle */ // Generally, angles are normalized to 0-2pai
		theta_e_test += theta_e_step;

		if (theta_e_test >= 6.283185307f)
		{
			theta_e_test -= 6.283185307f;
		}


		/* Park Transform */
		Park_Run(i_ab.alpha,
				 i_ab.beta,
				 theta_e_test,
				 &i_dq);

		/* ==================================================
		 * 4. READY 状�?�到这里停止
		 * ================================================== */
		if (foc_state == FOC_STATE_READY)
		{
			return;
		}


		/* ==================================================
		 * 5. 只有 RUN 才允许继续执行PI
		 * ================================================== */
		if (foc_state != FOC_STATE_RUN)
		{
			return;
		}

		/* Temporary dq voltage commands
		 * Later these will come from current PI controllers.
		 */

		/* Current controller */

		/* d-axis current PI */
		vd_cmd =
			PI_Run(&pi_id,
				   id_ref,
				   i_dq.d,
				   CURRENT_LOOP_TS);
		/* q-axis current PI */
		vq_cmd =
			PI_Run(&pi_iq,
				   iq_ref,
				   i_dq.q,
				   CURRENT_LOOP_TS);



		/* Inverse Park */
		InvPark_Run(vd_cmd,
					vq_cmd,
					theta_e_test,
					&v_ab);

		/* Copy voltage command */
		v_alpha_cmd = v_ab.alpha;
		v_beta_cmd  = v_ab.beta;


		/* Voltage vector limitation */
		SVPWM_LimitVoltage(&v_alpha_cmd,
						   &v_beta_cmd,
						   vdc_bus);

		SVPWM_Run(v_alpha_cmd,
				  v_beta_cmd,
				  vdc_bus,
				  &svpwm_out);

		pwm_ccr_u =
			DutyToCCR(svpwm_out.duty_u);
		pwm_ccr_v =
			DutyToCCR(svpwm_out.duty_v);
		pwm_ccr_w =
			DutyToCCR(svpwm_out.duty_w);


		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_1,
							  pwm_ccr_u);
		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_2,
							  pwm_ccr_v);
		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_3,
							  pwm_ccr_w);
    }
}

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM4)
    {
        hall_capture =
            HAL_TIM_ReadCapturedValue(htim,
                                      TIM_CHANNEL_1);

        hall_edge_count++;


        /* Read HA / HB / HC */
        Hall_UpdateState();
        hall_sector = Hall_StateToSector(hall_state);

        Hall_UpdateDirection(hall_sector);

        Hall_UpdateSpeed(hall_capture);

        /* Remember latest Hall edge time */
        hall_last_edge_ms = HAL_GetTick();

        /* Save one Hall event for UART */
        hall_report_state =
            hall_state;

        hall_report_capture =
            hall_capture;

        hall_report_edge_count =
            hall_edge_count;


        hall_uart_pending = 1;
    }
}


