	      edge = hall_report_edge_count;

	      float hall_dt_ms =
	          (float)capture
	          * HALL_TIMER_TICK_S
	          * 1000.0f;

	      const char *dir_str;

	      if (hall_direction == HALL_DIR_CW)
	      {
	          dir_str = "CW";
	      }
	      else if (hall_direction == HALL_DIR_CCW)
	      {
	          dir_str = "CCW";
	      }
	      else
	      {
	          dir_str = "UNKNOWN";
	      }

	      int len =
	          snprintf(tx_buffer,
	                   sizeof(tx_buffer),
	                   "HALL:%u%u%u Sector=%d Dir=%s dt=%.2fms RPM=%.1f We=%.2f Valid=%u\r\n",
	                   (state >> 2) & 0x01,
	                   (state >> 1) & 0x01,
	                   state & 0x01,
	                   (int)hall_sector,
	                   dir_str,
	                   hall_dt_ms,
	                   hall_speed_rpm,
	                   hall_omega_e,
	                   hall_speed_valid);


	      HAL_UART_Transmit(&huart3,
	                        (uint8_t *)tx_buffer,
	                        len,
	                        HAL_MAX_DELAY);
	  }

  }
  /* USER CODE END 3 */
