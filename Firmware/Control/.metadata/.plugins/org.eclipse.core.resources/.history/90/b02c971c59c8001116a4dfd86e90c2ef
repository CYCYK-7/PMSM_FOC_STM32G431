static void FOC_ResetControl(void)
{
    PI_Reset(&pi_id);
    PI_Reset(&pi_iq);

    vd_cmd = 0.0f;
    vq_cmd = 0.0f;

    v_alpha_cmd = 0.0f;
    v_beta_cmd  = 0.0f;
}

static void FOC_SetNeutralPWM(void)
{
    uint32_t arr;
    uint32_t mid;

    arr =
        __HAL_TIM_GET_AUTORELOAD(&htim1);

    mid =
        (arr + 1U) / 2U;


    __HAL_TIM_SET_COMPARE(&htim1,
                          TIM_CHANNEL_1,
                          mid);

    __HAL_TIM_SET_COMPARE(&htim1,
                          TIM_CHANNEL_2,
                          mid);

    __HAL_TIM_SET_COMPARE(&htim1,
                          TIM_CHANNEL_3,
                          mid);
}

static void FOC_CheckStartButton(void)
{
    static uint8_t raw_last = 0U;
    static uint8_t stable_pressed = 0U;

    static uint8_t armed = 0U;
    static uint8_t handled = 0U;
    static uint8_t press_allowed = 0U;

    static uint32_t change_ms = 0U;
    static uint32_t press_start_ms = 0U;

    uint32_t now = HAL_GetTick();

    uint8_t raw_pressed =
        (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13)
         == GPIO_PIN_SET) ? 1U : 0U;

    /* 1. Detect raw input changes */
    if (raw_pressed != raw_last)
    {
        raw_last = raw_pressed;
        change_ms = now;
    }

    /* 2. Debounce for 30 ms */
    if ((uint32_t)(now - change_ms) < SW3_DEBOUNCE_MS)
    {
        return;
    }

    /* 3. Update stable button state */
    if (raw_pressed != stable_pressed)
    {
        stable_pressed = raw_pressed;

        if (stable_pressed)
        {
            press_start_ms = now;
            handled = 0U;

            /* Only a fresh press in READY is accepted */
            press_allowed =
                (armed &&
                 ((foc_state == FOC_STATE_READY) ||
                  (foc_state == FOC_STATE_OPEN_LOOP) ||
                  (foc_state == FOC_STATE_RUN)) &&
                 current_offset_done == 1U &&
                 foc_fault_request == 0U) ? 1U : 0U;

            armed = 0U;
        }
        else
        {
            /* Release re-arms the button */
            handled = 0U;
            armed = 1U;
        }
    }

    /* Released: wait for a new press */
    if (!stable_pressed)
    {
        armed = 1U;
        return;
    }

    /* 4. Long press, only once per press */
    if ((!handled) &&
        ((uint32_t)(now - press_start_ms)
         >= SW3_LONG_PRESS_MS))
    {
        handled = 1U;

        sw3_long_press_count++;

        if (press_allowed &&
            ((foc_state == FOC_STATE_OPEN_LOOP) ||
             (foc_state == FOC_STATE_RUN)) &&
            foc_fault_request == 0U)
        {
            /* Long press during powered control -> request early stop. */
            foc_stop_request = 1U;
        }
        else if (press_allowed &&
                 foc_state == FOC_STATE_READY &&
                 foc_fault_request == 0U &&
                 foc_real_align_request == 0U)
        {
            foc_real_align_request = 1U;
            sw3_align_request_count++;
        }
    }
}

static void FOC_StateManager(void)
{


	/* ---------- Global fault request ---------- */
    if (foc_fault_request)
    {
        foc_fault_request = 0;

        FOC_PWM_EmergencyDisable();
        align_after_bootstrap = 0;

        FOC_ResetControl();
        FOC_SetNeutralPWM();

        foc_state = FOC_STATE_FAULT;  //
    }


    switch (foc_state)
    {
        case FOC_STATE_INIT:
        {
            /* Initialization is handled in main() */
            break;
        }


        case FOC_STATE_CALIBRATION:
        {
            /* Offset calibration is handled
             * inside ADC injected ISR.  //偏移校准在ADC注入式ISR内部处理
             */
            break;
        }


        case FOC_STATE_READY:
        {
            /* A dedicated real-alignment request must always charge bootstrap first. */
            if (foc_real_align_request != 0U)
            {
                foc_real_align_request = 0U;
                /* The two-pass calibration is finished: require MCU reset for another run. */
                if ((HALL_CALIB_MODE != 0U) && (hall_calib_stage >= 2U))
                {
                    break;
                }
                if (FOC_CanStart() && hall_angle_valid)
                {
                    foc_real_align_done = 0U;
                    align_max_abs_phase_current = 0.0f;
                    align_after_bootstrap = 1U;
                    foc_bootstrap_request = 1U;
                }
                break;
            }

        	if (foc_bootstrap_request)
        	{
        	    foc_bootstrap_request = 0;

        	    if (FOC_CanStart())
        	    {
        	        /* Disable all three-phase outputs first */
        	        FOC_PWM_Disable();

        	        FOC_ResetControl();

        	        /* PWM1: CCR=0 means high-side off,
        	           complementary low-side command active */
        	        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
        	        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
        	        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, 0);

        	        foc_bootstrap_done = 0;
        	        bootstrap_elapsed_ms = 0;
        	        bootstrap_ccer_snapshot = 0;

        	        bootstrap_start_ms = HAL_GetTick();

        	        foc_state = FOC_STATE_BOOTSTRAP_PREPARE;
        	    }
        	    else
        	    {
        	        /* 启动条件不满足，清除待执行的定位任务 */
        	        align_after_bootstrap = 0U;
        	    }

        	    break;
        	}
        	if (foc_align_test_request)
        	{
        	    foc_align_test_request = 0;

        	    if (FOC_CanStart())
        	    {
        	        /* Power outputs must remain disabled */
        	        FOC_PWM_Disable();

        	        FOC_ResetControl();
        	        FOC_SetNeutralPWM();

        	        foc_align_test_done = 0;
        	        align_test_calc_count = 0;
        	        align_test_elapsed_ms = 0;

        	        align_test_start_ms = HAL_GetTick();

        	        foc_state = FOC_STATE_ALIGN_TEST;
        	    }

        	    break;
        	}
            /* ---------- Original normal start ---------- */
            if (foc_start_request)
            {
                /*
                 * Consume this start request.
                 */
                foc_start_request = 0;


                /*
                 * Check whether the system
                 * is really allowed to run.
                 */
                if (FOC_CanStart())
                {
                    FOC_ResetControl();

                    FOC_SetNeutralPWM();


                    /*
                     * Real power PWM is NOT enabled yet.
                     * Real rotor electrical angle
                     * has not been established.
                     */
                    // FOC_PWM_Enable();


                    /* RUN is deliberately locked until actual Hall offset calibration. */
                    /* foc_state = FOC_STATE_RUN; */
                }
            }

            break;
        }

        case FOC_STATE_ALIGN_TEST:
        {
            /* Never enable physical phase PWM */
            FOC_PWM_Disable();

            align_test_elapsed_ms =
                (uint32_t)(
                    HAL_GetTick() - align_test_start_ms
                );

            /* Allow manual cancellation */
            if (foc_stop_request)
            {
                foc_stop_request = 0;

                FOC_PWM_Disable();
                FOC_SetNeutralPWM();

                foc_state = FOC_STATE_READY;
                break;
            }

            /* Automatically finish after 3 seconds */
            if (align_test_elapsed_ms >= ALIGN_TEST_DURATION_MS)
            {
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();

                foc_align_test_done = 1;

                foc_state = FOC_STATE_READY;
            }

            break;
        }

        case FOC_STATE_BOOTSTRAP_PREPARE:
        {
            if (foc_stop_request)
            {
                foc_stop_request = 0;
                align_after_bootstrap = 0U;
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();
                foc_state = FOC_STATE_READY;
                break;
            }

            /* Wait for CCR=0 to take effect */
            if ((uint32_t)(HAL_GetTick() - bootstrap_start_ms)
                >= BOOTSTRAP_PREPARE_MS)
            {
                /* Keep high-side channels disabled */
                CLEAR_BIT(TIM1->CCER,
                          TIM_CCER_CC1E |
                          TIM_CCER_CC2E |
                          TIM_CCER_CC3E);

                /*
                 * Enable complementary outputs only:
                 * CH1N, CH2N, CH3N.
                 */
                SET_BIT(TIM1->CCER,
                        TIM_CCER_CC1NE |
                        TIM_CCER_CC2NE |
                        TIM_CCER_CC3NE);

                bootstrap_ccer_snapshot =
                    TIM1->CCER & 0x0555U;

                bootstrap_start_ms = HAL_GetTick();

                foc_state = FOC_STATE_BOOTSTRAP_CHARGE;
            }

            break;
        }

        case FOC_STATE_BOOTSTRAP_CHARGE:
        {
            bootstrap_elapsed_ms =
                (uint32_t)(HAL_GetTick() - bootstrap_start_ms);

            if (foc_stop_request)
            {
                foc_stop_request = 0;
                align_after_bootstrap = 0U;
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();
                foc_state = FOC_STATE_READY;
                break;
            }

            if (bootstrap_elapsed_ms >= BOOTSTRAP_CHARGE_MS)
            {
                /* Disable low-side outputs BEFORE restoring CCR */
                FOC_PWM_Disable();

                FOC_SetNeutralPWM();

                foc_bootstrap_done = 1;
                if (align_after_bootstrap != 0U)
                {
                    align_after_bootstrap = 0U;
                    FOC_ResetControl();
                    FOC_RealAlign_PrepareVector();
                    align_prepare_start_ms = HAL_GetTick();
                    foc_state = FOC_STATE_ALIGN_PREPARE;
                }
                else
                {
                    foc_state = FOC_STATE_READY;
                }
            }

            break;
        }

        case FOC_STATE_ALIGN_PREPARE:
        {
            if (foc_stop_request)
            {
                foc_stop_request = 0;
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();
                foc_state = FOC_STATE_READY;
                break;
            }

            if ((uint32_t)(HAL_GetTick() - align_prepare_start_ms) >= ALIGN_PREPARE_MS)
            {
#if ALIGN_POWER_ALLOWED
                if (FOC_CanStart() && hall_angle_valid)
                {
                    /* CCRs have been preloaded; now enable physical outputs. */
                	FOC_PWM_Enable();

                	/* Record PWM enable status */
                	align_pwm_ccer_snapshot =
                	    TIM1->CCER & 0x0555U;

                	align_pwm_moe_snapshot =
                	    ((TIM1->BDTR & TIM_BDTR_MOE) != 0U)
                	    ? 1U : 0U;

                	align_active_start_ms = HAL_GetTick();

                	foc_state = FOC_STATE_ALIGN_ACTIVE;
                }
                else
                {
                    FOC_PWM_Disable();
                    FOC_SetNeutralPWM();
                    foc_state = FOC_STATE_READY;
                }
#else
                /* Power interlock is closed: never energize motor. */
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();
                foc_state = FOC_STATE_READY;
#endif
            }
            break;
        }

        case FOC_STATE_ALIGN_ACTIVE:
        {
            uint8_t natural_completion =
                ((uint32_t)(HAL_GetTick() - align_active_start_ms) >= ALIGN_ACTIVE_MS);
            if (foc_stop_request || natural_completion)
            {
                uint8_t was_cancelled = foc_stop_request;
                foc_stop_request = 0;
                align_final_sector = hall_sector;
                foc_real_align_done = (natural_completion && !was_cancelled) ? 1U : 0U;
                /* At theta_s=0, the Hall sector center supplies ONLY a coarse hint. */
                if ((HALL_CALIB_MODE != 0U) && (hall_sector >= 0) &&
                    foc_real_align_done)
                {
                    hall_calib_align_sector = hall_sector;
                    hall_calib_coarse_offset_rad = WrapAngle0To2Pi(
                        -((float)hall_sector + 0.5f) * HALL_SECTOR_ANGLE_RAD);
                }

                if (foc_real_align_done &&
                    (foc_fault_request == 0U) &&
                    (foc_fault_code == FOC_FAULT_NONE) &&
                    (hall_angle_valid != 0U) &&
                    ((TIM1->CCER & 0x0555U) == 0x0555U) &&
                    (CURRENT_TEST_AFTER_ALIGN != 0U))
                {
                    /* Keep PWM on; start a short Hall-angle current-loop test. */
                    FOC_CurrentTest_Begin();
                    foc_state = FOC_STATE_RUN;
                }
                else if (foc_real_align_done &&
                         (foc_fault_request == 0U) &&
                         (foc_fault_code == FOC_FAULT_NONE) &&
                         ((TIM1->CCER & 0x0555U) == 0x0555U) &&
                         (OPEN_LOOP_AFTER_ALIGN != 0U))
                {
                    /* Previous open-loop option remains available. */
                    FOC_OpenLoop_Begin();
                    foc_state = FOC_STATE_OPEN_LOOP;
                }
                else
                {
                    FOC_PWM_Disable();
                    FOC_SetNeutralPWM();
                    foc_state = FOC_STATE_READY;
                }
            }
            break;
        }

        case FOC_STATE_OPEN_LOOP:
        {
            uint8_t elapsed =
                ((uint32_t)(HAL_GetTick() - open_loop_start_ms) >= OPEN_LOOP_DURATION_MS);
            if (foc_stop_request || open_loop_timeout_hit || elapsed)
            {
                uint8_t stopped_early = foc_stop_request;
                foc_stop_request = 0U;
                /* Disable output BEFORE restoring neutral CCR values. */
                FOC_PWM_Disable();
                FOC_SetNeutralPWM();
                open_loop_hall_edge_delta = hall_edge_count - open_loop_hall_edge_start;
                foc_open_loop_done = (!stopped_early &&
                                     foc_fault_request == 0U &&
                                     foc_fault_code == FOC_FAULT_NONE) ? 1U : 0U;
                /* Freeze ISR samples before computing the per-pass offset. */
                hall_calib_collect_enabled = 0U;
                if ((HALL_CALIB_MODE != 0U) && foc_open_loop_done)
                {
                    HallCalib_FinishPass();
                }
                foc_state = FOC_STATE_READY;
            }
            break;
        }

        case FOC_STATE_RUN:
        {
            uint8_t elapsed =
                ((uint32_t)(HAL_GetTick() - current_test_start_ms)
                 >= CURRENT_TEST_DURATION_MS) ? 1U : 0U;
            if (foc_stop_request || current_test_timeout_hit || elapsed)
            {
                uint8_t cancelled = foc_stop_request;
                foc_stop_request = 0U;
                FOC_PWM_Disable();  /* switch off BEFORE neutral compare values */
                FOC_SetNeutralPWM();

                current_test_hall_edge_delta =
                    hall_edge_count - current_test_hall_edge_start;
                if (current_test_steady_samples > 0U)
                {
                    float n = (float)current_test_steady_samples;
                    current_test_avg_id_a = current_test_sum_id_a / n;
                    current_test_avg_iq_a = current_test_sum_iq_a / n;
                    current_test_avg_iq_error_a = current_test_sum_iq_error_a / n;
                }
                foc_current_test_done =
                    (!cancelled && !foc_fault_request &&
                     foc_fault_code == FOC_FAULT_NONE) ? 1U : 0U;
                /* The capture buffer is frozen: RUN updates cease in READY.
                 * Serial output will happen in main(), only after PWM is off. */
                current_trace_dump_pending = 1U;
                id_ref = 0.0f;
                iq_ref = 0.0f;
                FOC_ResetControl();
                foc_state = FOC_STATE_READY;
            }
            break;
        }


        case FOC_STATE_FAULT:
        {
            /*
             * Keep outputs disabled while fault is latched.
             */
            FOC_PWM_EmergencyDisable();

            FOC_ResetControl();
            FOC_SetNeutralPWM();


            /*
             * Explicit fault reset is required.
             */
            if (foc_fault_reset_request)
            {
                foc_fault_reset_request = 0;


                /*
                 * Reset current offset calibration.
                 */
                current_offset_done  = 0;
                current_offset_count = 0;

                iu_offset_sum = 0;
                iv_offset_sum = 0;


                /*
                 * Reset controller.
                 */
                FOC_ResetControl();
                FOC_SetNeutralPWM();


                /*
                 * Disable phase outputs first.
                 * CH4 remains enabled.
                 */
                FOC_PWM_Disable();


                /*
                 * MOE was cleared by EmergencyDisable.
                 * Re-enable MOE so CH4 can trigger ADC again.
                 *
                 * CH1~CH3 are still disabled in CCER,
                 * therefore phase power outputs remain OFF.
                 */
                __HAL_TIM_MOE_ENABLE(&htim1);


                /*
                 * Clear latched fault information.
                 */
                foc_fault_code = FOC_FAULT_NONE;


                /*
                 * Re-calibrate current offset before READY.
                 */
                foc_state = FOC_STATE_CALIBRATION;
            }

            break;
        }


        default:
        {
            FOC_ResetControl();
            FOC_SetNeutralPWM();

            foc_state = FOC_STATE_FAULT;

            break;
        }
    }
}


static void FOC_PWM_Enable(void)
{
    __HAL_TIM_MOE_ENABLE(&htim1);
    SET_BIT(TIM1->CCER,
            TIM_CCER_CC1E  |
            TIM_CCER_CC1NE |
            TIM_CCER_CC2E  |
            TIM_CCER_CC2NE |
            TIM_CCER_CC3E  |
            TIM_CCER_CC3NE);
}

static void FOC_PWM_Disable(void)
{
    CLEAR_BIT(TIM1->CCER,
              TIM_CCER_CC1E  |
              TIM_CCER_CC1NE |
              TIM_CCER_CC2E  |
              TIM_CCER_CC2NE |
              TIM_CCER_CC3E  |
              TIM_CCER_CC3NE);
}

static void FOC_TriggerFault(FOC_Fault_t fault_code)
{
    /*
     * Only latch the first fault.
     */
    if ((foc_state != FOC_STATE_FAULT) &&
        (foc_fault_request == 0))
    {
        foc_fault_code = fault_code;

        /*
         * Immediately stop inverter output.
         */
        FOC_PWM_EmergencyDisable();

        /*
         * Ask state manager to enter FAULT.
         */
        foc_fault_request = 1;
    }
}

static void FOC_PWM_EmergencyDisable(void)
{
    __HAL_TIM_MOE_DISABLE_UNCONDITIONALLY(&htim1);
}

static void FOC_CheckVdcProtection(void)
{
    /* ==========================================
     * Over-voltage protection
     * READY �??? RUN 都可以检测过�???
     * ========================================== */
    if ((foc_state == FOC_STATE_ALIGN_PREPARE) ||
        (foc_state == FOC_STATE_ALIGN_ACTIVE) ||
        (foc_state == FOC_STATE_OPEN_LOOP) ||
        (foc_state == FOC_STATE_BOOTSTRAP_PREPARE) ||
    	(foc_state == FOC_STATE_BOOTSTRAP_CHARGE) ||
		(foc_state == FOC_STATE_READY) ||
    	(foc_state == FOC_STATE_ALIGN_TEST) ||
        (foc_state == FOC_STATE_RUN)  )
    {
        if (vdc_bus > vdc_ov_trip)
        {
            if (vdc_ov_counter < VDC_FAULT_CONFIRM_SAMPLES)
            {
                vdc_ov_counter++;
            }

            if (vdc_ov_counter >= VDC_FAULT_CONFIRM_SAMPLES)
            {
                FOC_TriggerFault(
                    FOC_FAULT_VDC_OVERVOLTAGE);
            }
        }
        else
        {
            vdc_ov_counter = 0;
        }
    }
    else
    {
        vdc_ov_counter = 0;
    }


    /* ==========================================
     * Under-voltage protection
     * 当前只在 RUN 中检�???
     * ========================================== */
    if ((foc_state == FOC_STATE_ALIGN_PREPARE) ||
        (foc_state == FOC_STATE_ALIGN_ACTIVE) ||
        (foc_state == FOC_STATE_OPEN_LOOP) ||
        (foc_state == FOC_STATE_BOOTSTRAP_PREPARE) ||
    	(foc_state == FOC_STATE_BOOTSTRAP_CHARGE) ||
		(foc_state == FOC_STATE_ALIGN_TEST) ||
		foc_state == FOC_STATE_RUN)
    {
        if (vdc_bus < vdc_uv_trip)
        {
            if (vdc_uv_counter < VDC_FAULT_CONFIRM_SAMPLES)
            {
                vdc_uv_counter++;
            }

            if (vdc_uv_counter >= VDC_FAULT_CONFIRM_SAMPLES)
            {
                FOC_TriggerFault(
                    FOC_FAULT_VDC_UNDERVOLTAGE);
            }
        }
        else
        {
            vdc_uv_counter = 0;
        }
    }
    else
    {
        vdc_uv_counter = 0;
    }
}

static uint8_t FOC_CanStart(void)
{
    /*
     * 1. Current offset calibration must be finished.
     */
    if (current_offset_done == 0)
    {
        return 0;
    }


    /*
     * 2. There must be no active fault.
     */
    if ((foc_fault_request != 0) ||  //have fault return 0
        (foc_fault_code != FOC_FAULT_NONE))
    {
        return 0;
    }


    /*
     * 3. DC bus voltage must be inside
     *    the allowed operating range.
     */
    if (vdc_bus <= vdc_uv_trip)
    {
        return 0;
    }

    if (vdc_bus >= vdc_ov_trip)
    {
        return 0;
    }


    /*
     * All current start conditions are satisfied.
     */
    return 1;
}

static void FOC_CheckOverCurrent(void)
{
    uint8_t over_current = 0;

    iw_a = -(iu_a + iv_a);

    if ((iu_a > CURRENT_OC_TRIP_A) ||
        (iu_a < -CURRENT_OC_TRIP_A) ||
        (iv_a > CURRENT_OC_TRIP_A) ||
        (iv_a < -CURRENT_OC_TRIP_A) ||
        (iw_a > CURRENT_OC_TRIP_A) ||
        (iw_a < -CURRENT_OC_TRIP_A))
    {
        over_current = 1;
    }


    if (over_current)
    {
        if (current_oc_counter < CURRENT_OC_CONFIRM_SAMPLES)
        {
            current_oc_counter++;
        }

        if (current_oc_counter >= CURRENT_OC_CONFIRM_SAMPLES)
        {
            FOC_TriggerFault(FOC_FAULT_OVERCURRENT);
        }
    }
    else
    {
        current_oc_counter = 0;
    }
}

