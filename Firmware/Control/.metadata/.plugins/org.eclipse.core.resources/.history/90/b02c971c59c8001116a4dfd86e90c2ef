    open_loop_tick_count = 0U;
    open_loop_control_count = 0U;
    open_loop_theta_e = 0.0f;         /* seamless transition from alignment at alpha axis */
    open_loop_speed_cmd_rpm = 0.0f;
    open_loop_peak_current_a = 0.0f;
