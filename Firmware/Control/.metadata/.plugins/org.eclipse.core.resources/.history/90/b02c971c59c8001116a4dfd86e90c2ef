void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6)
    {
        /* Allow up to 20 ms for ALIGN -> OPEN_LOOP handoff.
         * The TIM6 hard cutoff remains independent of blocking UART calls. */
        if ((foc_state == FOC_STATE_ALIGN_ACTIVE) &&
            (uint32_t)(HAL_GetTick() - align_active_start_ms) >=
                (ALIGN_ACTIVE_MS +
                 (((OPEN_LOOP_AFTER_ALIGN != 0U) ||
                   (CURRENT_TEST_AFTER_ALIGN != 0U))
                      ? ALIGN_TO_OPENLOOP_GRACE_MS : 0U)))
        {
            FOC_PWM_Disable();
        }
        if ((foc_state == FOC_STATE_OPEN_LOOP) &&
            ((uint32_t)(HAL_GetTick() - open_loop_start_ms) >= OPEN_LOOP_DURATION_MS))
        {
            /* TIM6 shutdown still runs if the main loop is delayed by UART. */
            FOC_PWM_Disable();
            hall_calib_collect_enabled = 0U;  /* exclude unpowered coasting edges */
            open_loop_timeout_hit = 1U;
        }
        if ((foc_state == FOC_STATE_RUN) &&
            ((uint32_t)(HAL_GetTick() - current_test_start_ms)
             >= CURRENT_TEST_DURATION_MS))
        {
            FOC_PWM_Disable();
            current_test_timeout_hit = 1U;
        }
        timer_counter++; //1ms 1times

        if (timer_counter >= 1000) //1s
        {
            timer_counter = 0;
            uart_send_flag = 1;
        }
    }
}


void HAL_ADCEx_InjectedConvCpltCallback(ADC_HandleTypeDef *hadc)
{
	adc_callback_test_count++;
    if (hadc->Instance == ADC1)
    {
        iu_raw_sync =
            HAL_ADCEx_InjectedGetValue(&hadc1,
                                       ADC_INJECTED_RANK_1);

        current_sample_ready |= 0x01; //01
    }

    if (hadc->Instance == ADC2)
    {
        iv_raw_sync =
            HAL_ADCEx_InjectedGetValue(&hadc2,
                                       ADC_INJECTED_RANK_1);

        current_sample_ready |= 0x02; //10
    }

    /* U、V两相本周期数据都已经到齐 */
    if (current_sample_ready == 0x03) // 11
    {
        current_sample_ready = 0;

		vdc_bus =(float) vdc_adc_raw * VDC_VOLTS_PER_COUNT;  //后面 READY �??? FAULT 状�?�需要知�??? Vdc

        adc_injected_count++;

        /* DC bus protection */
        FOC_CheckVdcProtection();


        if (foc_fault_request) // 不加这个的话，真正foc_state = FOC_STATE_FAULT;要等while�???1）中的FOC_StateManager();执行之后
        {
            return;
        }

        /* ---------- Offset calibration ---------- */
        if (foc_state == FOC_STATE_CALIBRATION)
        {
            iu_offset_sum += iu_raw_sync;
            iv_offset_sum += iv_raw_sync;

            current_offset_count++;

            if (current_offset_count >= CURRENT_OFFSET_SAMPLES)
            {
                iu_offset_adc =
                    (uint16_t)(iu_offset_sum / CURRENT_OFFSET_SAMPLES);

                iv_offset_adc =
                    (uint16_t)(iv_offset_sum / CURRENT_OFFSET_SAMPLES);

                current_offset_done = 1;

                FOC_ResetControl();
                FOC_SetNeutralPWM();

                FOC_PWM_Disable();

                foc_state = FOC_STATE_READY;//after calibration state manager into ready
            }
            /*
             * 很重要：
             * CALIBRATION 状�?�做到这里就结束本次ADC回调�???
             * 不继续算电流、Park、PI�???
             */
            return;
        }

        /* ==================================================
         * 2. INIT / FAULT 状�?�直接�??�???
         * ================================================== */
        if ((foc_state == FOC_STATE_INIT) ||
            (foc_state == FOC_STATE_FAULT))
        {
            return;
        }

        /* ---------- Current calculation ---------- */
        /* ==================================================
         * 3. READY �??? RUN 都允许走到这�???
         *    �???以继续计算实际电�???
         * ================================================== */

        //standard FOC current direction e=i^*-i
		iu_adc_delta =
		    (int32_t)iu_offset_adc
		    - (int32_t)iu_raw_sync;

		iv_adc_delta =
		    (int32_t)iv_offset_adc
		    - (int32_t)iv_raw_sync;

		iu_a =
		    (float)iu_adc_delta
		    * CURRENT_A_PER_COUNT;

		iv_a =
		    (float)iv_adc_delta
		    * CURRENT_A_PER_COUNT;

		iu_ma = (int32_t)(iu_a * 1000.0f);
		iv_ma = (int32_t)(iv_a * 1000.0f);

        if (foc_state == FOC_STATE_OPEN_LOOP)
        {
            float iabs = (iu_a >= 0.0f) ? iu_a : -iu_a;
            float vabs = (iv_a >= 0.0f) ? iv_a : -iv_a;
            float wabs = (iu_a + iv_a >= 0.0f) ? (iu_a + iv_a) : -(iu_a + iv_a);
            if (iabs > open_loop_peak_current_a) open_loop_peak_current_a = iabs;
            if (vabs > open_loop_peak_current_a) open_loop_peak_current_a = vabs;
            if (wabs > open_loop_peak_current_a) open_loop_peak_current_a = wabs;
        }

        FOC_CheckOverCurrent();

        if (foc_state == FOC_STATE_RUN)
        {
            float a = fabsf(iu_a);
            float b = fabsf(iv_a);
            float c = fabsf(-(iu_a + iv_a));
            if (a > current_test_peak_abs_current_a) current_test_peak_abs_current_a = a;
            if (b > current_test_peak_abs_current_a) current_test_peak_abs_current_a = b;
            if (c > current_test_peak_abs_current_a) current_test_peak_abs_current_a = c;
        }

        if (foc_state == FOC_STATE_ALIGN_ACTIVE)
        {
            float iabs = iu_a < 0.0f ? -iu_a : iu_a;
            if (iabs > align_max_abs_phase_current) align_max_abs_phase_current = iabs;
            iabs = iv_a < 0.0f ? -iv_a : iv_a;
            if (iabs > align_max_abs_phase_current) align_max_abs_phase_current = iabs;
            iabs = iw_a < 0.0f ? -iw_a : iw_a;
            if (iabs > align_max_abs_phase_current) align_max_abs_phase_current = iabs;
        }

        if (foc_fault_request)
		{
		    return;
		}

		/* Clarke Transform */
		Clarke_Run(iu_a,
				   iv_a,
				   &i_ab);

		/* Test electrical angle */ // Generally, angles are normalized to 0-2pai
		theta_e_test += theta_e_step;

		if (theta_e_test >= 6.283185307f)
		{
			theta_e_test -= 6.283185307f;
		}

		/* Update real Hall interpolated angle */
		/*
		 * 不要只在 Hall 边沿中断里运行此函数
		 *  因为如果只在 Hall ISR 里算�?
		 *  �?个Hall边沿 �? 算一次角�?
		 *  直到下一个Hall边沿 �? 才再更新
		 *  这仍然不是连续角度，�?以放�?20 kHz ADC 同步控制 ISR 中�??
		 */
		Hall_UpdateElectricalAngle();

		/* Update FOC electrical angle from Hall */
		if (hall_angle_valid)
		{
		    hall_theta_corrected_test =WrapAngle0To2Pi(hall_theta_rel + hall_offset_test_rad);

		    theta_e_foc = hall_theta_corrected_test;
		}


		/* RUN状�?�下�?查Hall角度有效�? */
		if (((foc_state == FOC_STATE_RUN) ||
             (foc_state == FOC_STATE_ALIGN_ACTIVE)) &&
            (hall_angle_valid == 0U))
		{
		    FOC_TriggerFault(FOC_FAULT_HALL_INVALID);
		    return;
		}

		/* Alignment software-only test */
		if (foc_state == FOC_STATE_ALIGN_TEST)
		{
		    FOC_AlignTest_Calculate();
		    return;
		}

        /* Open-loop is independent from Hall offset and bypasses current PI. */
        if (foc_state == FOC_STATE_OPEN_LOOP)
        {
            open_loop_hall_edge_delta = hall_edge_count - open_loop_hall_edge_start;
            if (hall_speed_valid)
            {
                open_loop_last_hall_rpm = hall_speed_rpm;
                open_loop_last_hall_direction = (int8_t)hall_direction;
            }
            FOC_OpenLoop_Update();
            return;
        }

        /* During fixed-vector alignment, do not run the current PI. */
        if ((foc_state == FOC_STATE_ALIGN_PREPARE) ||
            (foc_state == FOC_STATE_ALIGN_ACTIVE))
        {
            return;
        }

		/* Park Transform */
		Park_Run(i_ab.alpha,
				 i_ab.beta,
				 theta_e_foc,
				 &i_dq);

		/* ==================================================
		 * 4. READY 状�?�到这里停止
		 * ================================================== */
		if (foc_state == FOC_STATE_READY)
		{
			return;
		}


		/* ==================================================
		 * 5. 只有 RUN 才允许继续执行PI
		 * ================================================== */
		if (foc_state != FOC_STATE_RUN)
		{
			return;
		}

        /* Timed, bounded first Hall current-loop experiment. */
        if (current_test_timeout_hit != 0U)
        {
            return;
        }
        uint32_t run_elapsed_ms =
            (uint32_t)(HAL_GetTick() - current_test_start_ms);
        if (run_elapsed_ms >= CURRENT_TEST_DURATION_MS)
        {
            FOC_PWM_Disable();
            current_test_timeout_hit = 1U;
            return;
        }
        if ((vdc_bus <= vdc_uv_trip) || (vdc_bus >= vdc_ov_trip))
        {
            FOC_TriggerFault((vdc_bus <= vdc_uv_trip)
                ? FOC_FAULT_VDC_UNDERVOLTAGE : FOC_FAULT_VDC_OVERVOLTAGE);
            return;
        }

        id_ref = 0.0f;
        if (run_elapsed_ms < CURRENT_TEST_ZERO_MS)
        {
            iq_ref = 0.0f;
        }
        else if (run_elapsed_ms < (CURRENT_TEST_ZERO_MS + CURRENT_TEST_RAMP_MS))
        {
            iq_ref = CURRENT_TEST_IQ_TARGET_A *
                (float)(run_elapsed_ms - CURRENT_TEST_ZERO_MS) /
                (float)CURRENT_TEST_RAMP_MS;
        }
        else
        {
            iq_ref = CURRENT_TEST_IQ_TARGET_A;
        }

        current_test_control_count++;
        current_test_last_id_a = i_dq.d;
        current_test_last_iq_a = i_dq.q;
        current_test_hall_edge_delta =
            hall_edge_count - current_test_hall_edge_start;
        if (run_elapsed_ms >= CURRENT_TEST_STEADY_MS)
        {
            current_test_sum_id_a += i_dq.d;
            current_test_sum_iq_a += i_dq.q;
            current_test_sum_iq_error_a += iq_ref - i_dq.q;
            current_test_steady_samples++;
        }

		/* Current controller */

		/* d-axis current PI */
		vd_cmd =
			PI_Run(&pi_id,
				   id_ref,
				   i_dq.d,
				   CURRENT_LOOP_TS);
		/* q-axis current PI */
		vq_cmd =
			PI_Run(&pi_iq,
				   iq_ref,
				   i_dq.q,
				   CURRENT_LOOP_TS);



        /* Limit total commanded voltage magnitude independently of SVPWM. */
        {
            float v2 = vd_cmd * vd_cmd + vq_cmd * vq_cmd;
            if (v2 > CURRENT_TEST_V_LIMIT_V * CURRENT_TEST_V_LIMIT_V)
            {
                float scale = CURRENT_TEST_V_LIMIT_V / sqrtf(v2);
                vd_cmd *= scale;
                vq_cmd *= scale;
                v2 = CURRENT_TEST_V_LIMIT_V * CURRENT_TEST_V_LIMIT_V;
            }
            if (sqrtf(v2) > current_test_peak_voltage_v)
                current_test_peak_voltage_v = sqrtf(v2);

            /* Same definition as the previous near-limit comparison tests. */
            if ((run_elapsed_ms >= CURRENT_TEST_STEADY_MS) &&
                (v2 >= (0.98f * CURRENT_TEST_V_LIMIT_V) *
                       (0.98f * CURRENT_TEST_V_LIMIT_V)))
            {
                current_test_steady_limit_samples++;
            }
        }

        /* Capture 10 ms block means, plus Iq min/max for ripple diagnosis. */
        FOC_CurrentTrace_Collect(run_elapsed_ms);

		/* Inverse Park */
		InvPark_Run(vd_cmd,
					vq_cmd,
					theta_e_foc,
					&v_ab);

		/* Copy voltage command */
		v_alpha_cmd = v_ab.alpha;
		v_beta_cmd  = v_ab.beta;


		/* Voltage vector limitation */
		SVPWM_LimitVoltage(&v_alpha_cmd,
						   &v_beta_cmd,
						   vdc_bus);

		SVPWM_Run(v_alpha_cmd,
				  v_beta_cmd,
				  vdc_bus,
				  &svpwm_out);

		pwm_ccr_u =
			DutyToCCR(svpwm_out.duty_u);
		pwm_ccr_v =
			DutyToCCR(svpwm_out.duty_v);
		pwm_ccr_w =
			DutyToCCR(svpwm_out.duty_w);


		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_1,
							  pwm_ccr_u);
		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_2,
							  pwm_ccr_v);
		__HAL_TIM_SET_COMPARE(&htim1,
							  TIM_CHANNEL_3,
							  pwm_ccr_w);
    }
}

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM4)
    {
        hall_capture =
            HAL_TIM_ReadCapturedValue(htim,
                                      TIM_CHANNEL_1);

        hall_edge_count++;


        /* Save sector BEFORE updating it: reject non-adjacent jumps. */
        int8_t sector_before_edge = hall_sector;
        Hall_UpdateState();
        hall_sector = Hall_StateToSector(hall_state);

        Hall_UpdateDirection(hall_sector);
        /* Must precede Hall_UpdateSpeed(): compare against previous speed. */
        HallAngle_OnHallEdge(hall_capture, sector_before_edge, hall_sector);
        Hall_UpdateSpeed(hall_capture);
        HallCalib_OnHallEdge(hall_sector);

        /* Remember latest Hall edge time */
        hall_last_edge_ms = HAL_GetTick();

        /* Save one Hall event for UART */
        hall_report_state =
            hall_state;

        hall_report_capture =
            hall_capture;

        hall_report_edge_count =
            hall_edge_count;


        hall_uart_pending = 1;
    }
}


